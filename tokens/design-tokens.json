    "$description": "Padding and gap tokens for component internals.",

    "field": {
      "px":  { "$value": "12px", "$type": "dimension", "$description": "Horizontal padding inside inputs and selects" },
      "py":  { "$value": "8px",  "$type": "dimension", "$description": "Vertical padding inside inputs" },
      "gap": { "$value": "6px",  "$type": "dimension", "$description": "Gap between icon and text inside a field" }
    },

    "button": {
      "px": {
        "xs": { "$value": "10px", "$type": "dimension" },
        "sm": { "$value": "12px", "$type": "dimension" },
        "md": { "$value": "12px", "$type": "dimension" },
