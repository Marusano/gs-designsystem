  "typography": {
    "$description": "Type styles — Inter typeface across all weights and sizes.",

    "family": {
      "base": { "$value": ["Inter", "sans-serif"], "$type": "fontFamily" }
    },

    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    },

    "size": {
      "xs":   { "$value": "12px", "$type": "dimension" },
      "sm":   { "$value": "13px", "$type": "dimension" },
      "base": { "$value": "14px", "$type": "dimension", "$description": "Default UI size — buttons, inputs, tags" },
      "md":   { "$value": "16px", "$type": "dimension" },
      "lg":   { "$value": "20px", "$type": "dimension" },
      "xl":   { "$value": "24px", "$type": "dimension" },
      "xxl":  { "$value": "32px", "$type": "dimension" }
    },

    "lineHeight": {
      "tight":   { "$value": "16px", "$type": "dimension", "$description": "Button and field labels" },
      "base":    { "$value": "20px", "$type": "dimension" },
      "relaxed": { "$value": "24px", "$type": "dimension" }
    }
  },

  "size": {
    "$description": "Sizing tokens — component heights, border radii, border widths.",

    "radius": {
      "$description": "Border radii. Components use 'sm' by default.",
      "none": { "$value": "0px",    "$type": "dimension" },
      "sm":   { "$value": "4px",    "$type": "dimension", "$description": "Default — buttons, fields, tags, checkboxes" },
      "md":   { "$value": "8px",    "$type": "dimension" },
      "lg":   { "$value": "16px",   "$type": "dimension" },
      "xl":   { "$value": "30px",   "$type": "dimension", "$description": "Pill / fully-rounded" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },

    "height": {
      "$description": "Interactive element heights — maps to button sizes and form fields.",
      "xs": { "$value": "32px", "$type": "dimension", "$description": "Button xs" },
      "sm": { "$value": "36px", "$type": "dimension", "$description": "Button sm / tag sm" },
      "md": { "$value": "40px", "$type": "dimension", "$description": "Button md / field default / tab strip" },
      "xl": { "$value": "56px", "$type": "dimension", "$description": "Button xl / header / tag md card" }
    },

    "border": {
      "sm": { "$value": "1px", "$type": "dimension", "$description": "Default border / focus ring width" },
      "lg": { "$value": "3px", "$type": "dimension", "$description": "Strong focus ring width" }
    },

