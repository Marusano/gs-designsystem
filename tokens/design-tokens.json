      "$description": "Semantic status colors for success, warning, danger and info states.",
      "success": { "$value": "{colors.primitive.green.60}",      "$type": "color" },
      "warning": { "$value": "{colors.primitive.yellow.60}",     "$type": "color" },
      "danger":  { "$value": "{colors.primitive.red.60}",        "$type": "color" },
      "info":    { "$value": "{colors.primitive.blue.azure.60}", "$type": "color" }
    },

    "surface": {
      "$description": "Background / container surface colors.",
      "default": { "$value": "{colors.primitive.grey.00}", "$type": "color", "$description": "Primary page / card background" },
      "subtle":  { "$value": "{colors.primitive.grey.05}", "$type": "color", "$description": "App background, sidebar" },
      "muted":   { "$value": "{colors.primitive.grey.10}", "$type": "color", "$description": "Table headers, selected tab bg" }
    },

    "text": {
      "$description": "Foreground text colors.",
      "primary":   { "$value": "{colors.primitive.grey.100}", "$type": "color" },
      "secondary": { "$value": "{colors.primitive.grey.70}",  "$type": "color" },
      "disabled":  { "$value": "{colors.primitive.grey.50}",  "$type": "color" },
